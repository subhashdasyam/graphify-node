{
  "name": "@graphify/node",
  "version": "0.1.0",
  "description": "Node TypeScript rewrite of graphify's deterministic knowledge graph engine",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "bin": {
    "graphify": "./dist/src/cli.js",
    "graphify-ts": "./dist/src/cli.js"
  },
  "files": [
    "dist",
    "vendor",
    "skills",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "test": "npm run build && node --test dist/test/*.test.js",
    "start": "tsx src/cli.ts"
  },
  "dependencies": {
    "typescript": "^5.9.3",
    "web-tree-sitter": "^0.26.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "tsx": "^4.20.6"
  },
  "engines": {
    "node": ">=20"
  }
}
